OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# Qdrant (leave QDRANT_URL empty for local file-based dev mode)
QDRANT_URL=http://qdrant:6333
QDRANT_PATH=rag_app/qdrant_data

# MongoDB (leave empty to use JSON file loader)
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB_NAME=gov_circulars

# CORS — comma-separated origins
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Embedding cache (use /app/data/ in Docker for volume mount)
EMBEDDING_CACHE_PATH=/app/data/embedding_cache.pkl

# Answer generation model (gpt-4o for quality, gpt-4o-mini for cost)
ANSWER_MODEL=gpt-4o

# Eval judge model (used by /evaluate endpoint and batch eval CLI)
EVAL_JUDGE_MODEL=gpt-4o
