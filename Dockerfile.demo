FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir streamlit openai psycopg2-binary python-dotenv
COPY demo_app.py ui_components.py demo_obligations.json ./
COPY scripts/extract_obligations.py ./scripts/
EXPOSE 8501
CMD ["streamlit", "run", "demo_app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
